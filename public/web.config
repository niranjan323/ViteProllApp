<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS rewrite rules for the CRoll React SPA.
  Azure App Service (Windows) uses IIS — without this, navigating to /project
  or refreshing any non-root route returns 404.
  This file is placed in public/ so Vite copies it into dist/ automatically.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Don't rewrite actual files (JS, CSS, images, PDF, etc.) -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Don't rewrite actual directories -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Send everything else to index.html — React Router takes over -->
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <!-- Serve .wasm files correctly (needed if any dependency uses WebAssembly) -->
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>
  </system.webServer>
</configuration>
